{
  "name": "iktisad-ci-guard",
  "url": "https://shiny-apricot.github.io/iktisad/",
  "hook_attributes": {
    "url": "https://shiny-apricot.github.io/iktisad/",
    "active": false
  },
  "redirect_url": "https://shiny-apricot.github.io/iktisad/setup",
  "public": true,
  "default_permissions": {
    "checks": "write",
    "contents": "read",
    "pull_requests": "write",
